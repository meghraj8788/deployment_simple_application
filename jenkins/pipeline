pipeline {
    agent any

    environment {
        AWS_REGION     = 'eu-north-1'
        ECR_REPO       = 'helloword'
        AWS_ACCOUNT_ID = '278387432250'
        IMAGE_TAG = "${BUILD_NUMBER}"
        region = "eu-north-1"
        cluster_name = "EksHelloWord"
        namespace = 'helloword'
        IMAGE          = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}"
    }

    stages {

        stage("Build") {
            steps {

                // Clone GitHub repository
                git branch: 'main',
                    credentialsId : "github-credentials",
                    url: 'https://github.com/meghraj8788/deployment_simple_application.git'

                // Build Docker image
                sh """
                    docker build -t ${ECR_REPO}:${IMAGE_TAG} ./hello_word_application
                """

                // Login to ECR
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} |
                    docker login --username AWS --password-stdin \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                """

                // Tag image
                sh """
                    docker tag ${ECR_REPO}:${IMAGE_TAG} ${IMAGE}
                """

                // Push image
                sh """
                    docker push ${IMAGE}
                """
            }
        }

        stage("Test") {
            steps {
                sh """
                docker images
                docker ps
                """
            }
        }

